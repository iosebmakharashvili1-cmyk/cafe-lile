{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordering-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Default (used by `wrangler dev` locally) points at the staging DB id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ordering-staging",
      "database_id": "6baa2d2e-f4ed-427e-b2cb-993e769248cb",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ALLOWED_PUBLIC_ORIGIN": "http://localhost:5173",
    "ALLOWED_ADMIN_ORIGIN": "http://localhost:5174"
  },

  "env": {
    "staging": {
      "name": "ordering-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ordering-staging",
          "database_id": "6baa2d2e-f4ed-427e-b2cb-993e769248cb",
          "migrations_dir": "migrations"
        }
      ],
      // IMPORTANT: replace these with your actual *.pages.dev URLs (shown after your
      // first Pages deploy) or your custom domain once DNS is set up. If these don't
      // match exactly, the browser will silently block every API request as CORS errors.
      "vars": {
        "ALLOWED_PUBLIC_ORIGIN": "https://cafe-lile-customer.pages.dev",
        "ALLOWED_ADMIN_ORIGIN": "https://cafe-lile-admin.pages.dev"
      }
    },
    "production": {
      "name": "ordering-api-prod",
      // No "routes" here on purpose: a custom domain route fails to deploy until that
      // domain's DNS is actually on this Cloudflare account. Until you've bought/moved
      // cafelile.ge here, production is reachable at the workers.dev URL Wrangler prints
      // after deploy (e.g. ordering-api-prod.<your-subdomain>.workers.dev).
      // Once DNS is ready, uncomment:
      // "routes": [{ "pattern": "api.cafelile.ge", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ordering-prod",
          "database_id": "ee8e28ad-520c-47e3-ad28-ea91839c6e22",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ALLOWED_PUBLIC_ORIGIN": "https://order.cafelile.ge",
        "ALLOWED_ADMIN_ORIGIN": "https://admin.cafelile.ge"
      }
    }
  }

  // Secrets (set via `wrangler secret put <NAME> --env <staging|production>`),
  // never in this file:
  //   SESSION_TOKEN_HASH_PEPPER
  //   IP_HASH_KEY
}
