# Copy to .env.local for local dev, or set as a build-time environment
# variable in the Cloudflare Pages project settings for staging/production.
#
# Without this, the app silently falls back to http://localhost:8787,
# which will fail with a network error once deployed.

VITE_API_BASE_URL=http://localhost:8787

# Free MapTiler API key (cloud.maptiler.com) — used for the delivery map
# picker at checkout. Free tier: 5,000 map sessions/month, no card required.
# Without this, the delivery map will fail to load.
VITE_MAPTILER_API_KEY=your-maptiler-key-here
